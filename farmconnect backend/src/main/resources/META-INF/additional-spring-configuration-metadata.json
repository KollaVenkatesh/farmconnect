                           "defaultValue":  86400000,
                           "description":  "JWT validity duration in milliseconds."
                       },
                       {
                           "name":  "razorpay.key-id",
                           "type":  "java.lang.String",
                           "description":  "Razorpay platform API key ID."
                       },
                       {
                           "name":  "razorpay.key-secret",
                           "type":  "java.lang.String",
                           "description":  "Razorpay platform API secret."
                       },
                       {
                           "name":  "razorpay.webhook-secret",
                           "type":  "java.lang.String",
                           "description":  "Secret used to verify Razorpay webhook signatures."
